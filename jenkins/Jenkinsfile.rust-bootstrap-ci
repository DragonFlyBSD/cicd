// PR CI + bootstrap publishing for DragonFlyBSD/rust-bootstrap-dragonfly.
// PR: build the changed version dir(s) to verify. master: build + publish them.
// Loaded from cicd via Remote Jenkinsfile Provider, so scm is cicd and the rust
// source is fetched explicitly. See docs/rust-bootstrap-ci.md.

def NODE_LABEL       = 'dragonflybsd-nvmm xlarge'
def RUST_REPO_URL    = 'https://github.com/DragonFlyBSD/rust-bootstrap-dragonfly.git'
def RUST_TARGET      = 'x86_64-unknown-dragonfly'
def BUILD_PKGS       = 'cmake ninja perl5 libssh gmake'
def RSYNC_DEST_CRED  = 'rust-bootstrap-rsync-dest'   // Secret text: host/module
def RSYNC_LOGIN_CRED = 'rust-upload'                 // Username with password

def changedVersions(String base) {
    String diff = sh(returnStdout: true, script: "git diff --name-only ${base} HEAD").trim()
    def versions = [] as LinkedHashSet
    diff.readLines().each { line ->
        def m = line =~ /^(\d+\.\d+\.\d+)\//
        if (m) versions << m.group(1)
    }
    return versions.findAll { fileExists("${it}/build.sh") }.sort()
}

pipeline {
    agent { label NODE_LABEL }

    options {
        timestamps()
        skipDefaultCheckout(true)
        disableConcurrentBuilds(abortPrevious: true)
        timeout(time: 8, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    boolean isPR = env.CHANGE_ID != null
                    env.PUBLISH = (!isPR && env.BRANCH_NAME == 'master') ? 'true' : 'false'

                    String ref, refspec
                    if (isPR) {
                        // refs/pull/N/head covers forks
                        ref = 'refs/remotes/origin/pr'
                        refspec = "+refs/pull/${env.CHANGE_ID}/head:${ref} " +
                                  "+refs/heads/${env.CHANGE_TARGET}:refs/remotes/origin/${env.CHANGE_TARGET}"
                    } else {
                        ref = "refs/remotes/origin/${env.BRANCH_NAME}"
                        refspec = "+refs/heads/${env.BRANCH_NAME}:${ref}"
                    }
                    checkout([$class: 'GitSCM',
                        branches: [[name: ref]],
                        userRemoteConfigs: [[url: RUST_REPO_URL, refspec: refspec]]])

                    env.DIFF_BASE = isPR
                        ? sh(returnStdout: true, script: "git merge-base HEAD origin/${env.CHANGE_TARGET}").trim()
                        : 'HEAD~1'
                }
            }
        }

        stage('Plan') {
            steps {
                script {
                    def versions = changedVersions(env.DIFF_BASE)
                    env.BUILD_VERSIONS = versions.join(' ')
                    String what = env.PUBLISH == 'true' ? 'Build + publish' : 'Build (verify)'
                    echo versions.isEmpty() ? 'Nothing to build.' : "${what}: ${env.BUILD_VERSIONS}"
                }
            }
        }

        stage('Build') {
            when { expression { env.BUILD_VERSIONS?.trim() } }
            steps {
                sh "pkg install -y ${BUILD_PKGS}"
                script {
                    for (v in env.BUILD_VERSIONS.trim().split(/\s+/)) {
                        sh """
                            set -eu
                            rm -rf "\$WORKSPACE/build-${v}"
                            cd '${v}'
                            sh ./build.sh "\$WORKSPACE/build-${v}"
                        """
                    }
                }
            }
        }

        stage('Publish') {
            when { expression { env.PUBLISH == 'true' && env.BUILD_VERSIONS?.trim() } }
            steps {
                withCredentials([
                    string(credentialsId: RSYNC_DEST_CRED, variable: 'RSYNC_DEST'),
                    usernamePassword(credentialsId: RSYNC_LOGIN_CRED,
                                     usernameVariable: 'RSYNC_USER', passwordVariable: 'RSYNC_PASSWORD'),
                ]) {
                    sh 'pkg install -y rsync'
                    script {
                        for (v in env.BUILD_VERSIONS.trim().split(/\s+/)) {
                            withEnv(["V=${v}", "T=${RUST_TARGET}"]) {
                                sh '''
                                    set -eu
                                    dist=$(dirname "$(find "$WORKSPACE/build-$V" -type f -name "cargo-$V-$T.tar.xz" | head -1)")
                                    cd "$dist"
                                    files=""
                                    for c in cargo-$V-$T rustc-$V-$T rust-std-$V-$T; do
                                        sha256 -r "$c.tar.xz" > "$c.tar.xz.sha256"
                                        files="$files $c.tar.xz $c.tar.xz.sha256"
                                    done
                                    rsync -av --mkpath $files "rsync://${RSYNC_USER}@${RSYNC_DEST}/$V/"
                                '''
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs(notFailBuild: true)
        }
    }
}
