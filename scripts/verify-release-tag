#!/usr/bin/env python3
"""Verify the release tag's first signature and signed identity."""
import sys
from release_signing import SigningError, load_request
from release_verification import verify_tag

if __name__ == '__main__':
    try:
        if len(sys.argv) != 2:
            raise SigningError('usage: verify-release-tag release-signing-request.json')
        request = load_request(sys.argv[1])
        oid, signer = verify_tag(request)
        print(f"OK: {request['release_tag']} verified (signer {signer}) against {request['commit']} (tag object {oid})")
    except (SigningError, OSError, UnicodeError) as exc:
        sys.exit(f'verify-release-tag: {exc}')
