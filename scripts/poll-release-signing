#!/usr/bin/env python3
"""One Jenkins signing poll: 0 verified, 2 absent, 1 operational/verification failure."""

import argparse
from contextlib import contextmanager
import os
from pathlib import Path
import subprocess
import sys
import tempfile

from release_signing import SigningError, load_request


@contextmanager
def credentials():
    # Never write credential values or print the credential environment.
    with tempfile.TemporaryDirectory(prefix='release-askpass-') as temporary:
        askpass = Path(temporary) / 'askpass'
        askpass.write_text('''#!/bin/sh
case "$1" in
*Username*) printf '%s\\n' "$GITEA_USER" ;;
*Password*) printf '%s\\n' "$GITEA_TOKEN" ;;
*) printf '\\n' ;;
esac
''')
        askpass.chmod(0o700)
        yield dict(os.environ, GIT_ASKPASS=str(askpass), GIT_TERMINAL_PROMPT='0')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('phase', choices=['tag', 'approval'])
    args = parser.parse_args()
    workspace = Path(os.environ['WORKSPACE']).resolve()
    scripts = Path(__file__).resolve().parent
    request_path = workspace / 'release-signing-request.json'
    request = load_request(request_path)
    tag = request['release_tag']
    source = workspace / 'src'
    with credentials() as environment:
        environment['AUTHORIZED_SIGNERS_DIR'] = str(scripts.parent / 'keys/authorized-signers')
        def run(arguments, **kwargs):
            return subprocess.run(arguments, env=environment, check=False, **kwargs)

        if args.phase == 'tag':
            result = run(['git', 'ls-remote', '--exit-code', '--tags', request['origin_url'],
                          f'refs/tags/{tag}'], stdout=subprocess.DEVNULL)
            if result.returncode == 2:
                return 2
            if result.returncode:
                raise SigningError('cannot query source origin')
        else:
            result = run([sys.executable, str(scripts / 'fetch-release-approval'),
                          '--git-dir', str(workspace / 'approval-data.git'),
                          '--ref', os.environ['RELEASE_APPROVALS_REF'], '--tag', tag,
                          '--output', str(workspace / 'release-approval')])
            if result.returncode:
                return result.returncode
        # Always refresh the source tag, including after waiting for approval.
        result = run(['git', 'fetch', '--force', 'origin', f'refs/tags/{tag}:refs/tags/{tag}'], cwd=source)
        if result.returncode:
            raise SigningError('cannot fetch current source tag')
        command = [sys.executable, str(scripts / ('verify-release-tag' if args.phase == 'tag'
                                                else 'verify-release-approval'))]
        if args.phase == 'approval':
            command += ['--report', str(workspace / 'release-approval/verification.json')]
        command.append(str(request_path))
        if args.phase == 'approval':
            command.append(str(workspace / 'release-approval'))
        result = run(command, cwd=source)
        # A verifier failure must never be interpreted as missing evidence.
        return 0 if result.returncode == 0 else 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (SigningError, OSError, KeyError, UnicodeError) as exc:
        sys.exit(f'poll-release-signing: {exc}')
