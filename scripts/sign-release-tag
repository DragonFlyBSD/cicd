#!/usr/bin/env python3
"""Review and create a release tag with an explicitly selected local GPG key."""

import argparse
import subprocess
import sys

from release_signing import SigningError, git, load_request
from release_verification import authorized_keyring
from release_review import confirm, display, remote_refs, review_source, signing_key


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--key', required=True, help='full primary signing-key fingerprint')
    parser.add_argument('--origin', required=True, help='independently known source origin URL')
    parser.add_argument('--previous-tag', help='override the comparison final release tag')
    parser.add_argument('request')
    args = parser.parse_args()
    request = load_request(args.request)
    key = signing_key(args.key)
    with authorized_keyring() as (_, allowed):
        if key not in allowed:
            raise SigningError('signing key is not an authorized primary key')
    tag = request['release_tag']
    git('rev-parse', '--git-dir')
    existing = subprocess.run(['git', 'show-ref', '--verify', '--quiet', f'refs/tags/{tag}'])
    if existing.returncode == 0:
        raise SigningError(f'tag already exists locally: {tag}')
    if existing.returncode != 1:
        raise SigningError('cannot check existing tag')
    refs = review_source(request, args.origin, args.previous_tag)
    if f'refs/tags/{tag}' in refs:
        raise SigningError('release tag already exists on origin; fetch and review it instead')
    display(f'Signing primary key: {key}')
    confirm(request, 'sign')
    if f'refs/tags/{tag}' in remote_refs(request, args.origin):
        raise SigningError('release tag appeared during review; no tag was created')
    git('-c', 'gpg.format=openpgp', 'tag', '-s', '-u', key, '-m', request['tag_message'], tag, request['commit'])
    print(f"Created signed tag {tag} -> {request['commit']}")
    print(f'Push with: git push origin refs/tags/{tag}:refs/tags/{tag}')


if __name__ == '__main__':
    try:
        main()
    except (SigningError, OSError, UnicodeError) as exc:
        sys.exit(f'sign-release-tag: {exc}')
