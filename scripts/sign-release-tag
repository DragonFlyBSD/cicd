#!/usr/bin/env python3
"""Create a signed release tag locally; never upload private signing material."""

import subprocess
import sys

from release_signing import SigningError, git, load_request, require_commit


def main():
    if len(sys.argv) != 2:
        raise SigningError("usage: sign-release-tag release-signing-request.json")
    request = load_request(sys.argv[1])
    tag = request["release_tag"]
    commit = request["commit"]
    git("rev-parse", "--git-dir")
    require_commit(commit)
    existing = subprocess.run(
        ["git", "show-ref", "--verify", "--quiet", f"refs/tags/{tag}"]
    )
    if existing.returncode == 0:
        raise SigningError(f"tag already exists locally: {tag}")
    if existing.returncode != 1:
        raise SigningError("cannot check existing tag")

    # Use the signer's locally configured OpenPGP key. Key selection/review UI
    # is intentionally unchanged here; never sign automatically on Jenkins.
    git("-c", "gpg.format=openpgp", "tag", "-s", "-m", request["tag_message"], tag, commit)
    print(f"Created signed tag {tag} -> {commit}")
    print(git("--no-pager", "show", "--no-patch", f"refs/tags/{tag}").decode(), end="")
    print(f"After review, push with: git push origin refs/tags/{tag}:refs/tags/{tag}")


if __name__ == "__main__":
    try:
        main()
    except (SigningError, OSError) as exc:
        sys.exit(f"sign-release-tag: {exc}")
